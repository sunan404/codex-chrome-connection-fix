{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-paper-reviewer.invalid/schemas/common.json",
  "$defs": {
    "statement": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "information_type": {
          "type": "string",
          "enum": [
            "manuscript_fact",
            "external_fact",
            "reviewer_inference",
            "recommendation"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "external_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reasoning": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "information_type",
        "evidence_ids",
        "external_source_ids",
        "reasoning"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "source_hash",
        "start",
        "end",
        "text",
        "section",
        "page",
        "line",
        "location"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "text",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "empirical",
            "method",
            "theoretical",
            "scope"
          ]
        },
        "strength": {
          "type": "string",
          "enum": [
            "bounded",
            "qualified",
            "universal"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "claim_id",
        "text",
        "evidence_ids",
        "claim_type",
        "strength",
        "scope"
      ],
      "additionalProperties": false
    }
  }
}
